# ===================================================
# SpillTrace Environment Configuration Template
# Copy this file to .env or .env.local for local overrides.
# In production, set these via Vercel and Render dashboards.
# ===================================================

# Frontend Configuration (Vercel)
# Local: http://127.0.0.1:8000
# Production: https://<your-render-backend-name>.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend Configuration (Render)
# Local: http://localhost:5173
# Production: https://<your-vercel-frontend-name>.vercel.app
FRONTEND_URL=http://localhost:5173

# Server Binding
HOST=0.0.0.0
PORT=8000
